<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management | MES</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark mb-4" id="adminNav">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">🏭 MES SYSTEM</a>
        <a href="/" class="btn btn-outline-light btn-sm" id="backToDashBtn">← Back to Dashboard</a>
    </div>
</nav>

<div class="container">
    <!-- Flash Messages -->
    <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
      <% messages.forEach(function(item) { %>
        <div class="alert alert-<%= item.category || 'info' %> alert-dismissible fade show shadow-sm" role="alert">
          <%= item.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% }); %>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">User Management</h2>
            <small class="text-muted">Total system users: <%= user_count %></small>
        </div>
        <button class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#createUserModal" id="btnOpenCreateUserModal">
            ＋ Create New User
        </button>
    </div>

    <!-- Create User Modal -->
    <div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/admin/create-user" method="POST" id="createUserForm">
                    <div class="modal-header">
                        <h5 class="modal-title">Create New User Account</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Username</label>
                            <input type="text" name="username" class="form-control" required id="newUsername">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Email Address</label>
                            <input type="email" name="email" class="form-control" required id="newEmail">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Role</label>
                            <select name="role" class="form-select" id="newRole">
                                <option value="operator">Operator</option>
                                <option value="manager">Manager</option>
                                <option value="admin">Admin</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Password</label>
                            <input type="password" name="password" class="form-control" required id="newPassword">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Confirm Password</label>
                            <input type="password" name="confirm_password" class="form-control" required id="newConfirmPassword">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="submitCreateUserBtn">Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="usersTable">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(function(user) { %>
                    <tr class="<%= user.id === current_user.id ? 'table-info' : '' %>" id="user-row-<%= user.id %>">
                        <td><%= user.id %></td>
                        <td class="fw-bold"><%= user.username %> <%= user.id === current_user.id ? '(You)' : '' %></td>
                        <td><%= user.email %></td>
                        <td>
                            <span class="badge <%= user.role === 'admin' ? 'bg-danger' : (user.role === 'manager' ? 'bg-warning' : 'bg-secondary') %>">
                                <%= user.role.toUpperCase() %>
                            </span>
                        </td>
                        <td>
                            <% if (user.is_active) { %>
                                <span class="badge bg-success">Active</span>
                            <% } else { %>
                                <span class="badge bg-danger">Inactive</span>
                            <% } %>
                        </td>
                        <td class="small"><%= new Date(user.date_created).toISOString().split('T')[0] %></td>
                        <td class="text-end">
                            <% if (user.id !== current_user.id) { %>
                            <div class="d-flex justify-content-end gap-2">
                                <form action="/admin/toggle-user/<%= user.id %>" method="POST">
                                    <button class="btn btn-sm <%= user.is_active ? 'btn-outline-secondary' : 'btn-outline-success' %>">
                                        <%= user.is_active ? 'Deactivate' : 'Activate' %>
                                    </button>
                                </form>
                                <form action="/admin/delete-user/<%= user.id %>" method="POST" onsubmit="return confirm('Are you sure? This cannot be undone.');">
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Auto-dismiss alerts after 4 seconds
    window.setTimeout(function() {
        var alerts = document.querySelectorAll('.alert');
        alerts.forEach(function(alert) {
            var bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        });
    }, 4000);
</script>
</body>
</html>
