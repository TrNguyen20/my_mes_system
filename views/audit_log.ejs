<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nhật ký hệ thống | MES</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark mb-4" id="auditNav">
    <div class="container">
        <a class="navbar-brand" href="/" id="backDash">🏠 Quay lại Dashboard</a>
        <span class="navbar-text text-warning fw-bold">NHẬT KÝ HÀNH ĐỘNG (AUDIT LOG)</span>
    </div>
</nav>

<div class="container">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped align-middle" id="auditLogTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Thời gian</th>
                            <th>Người thực hiện</th>
                            <th>Hành động</th>
                            <th>Đối tượng</th>
                            <th>Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (logs.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Chưa có nhật ký ghi nhận.</td>
                        </tr>
                        <% } %>
                        <% logs.forEach(function(log) { %>
                        <tr>
                            <td><%= new Date(log.timestamp).toLocaleString('vi-VN') %></td>
                            <td><span class="badge bg-info text-dark"><%= (log.user && log.user.username) || log.username || 'System' %></span></td>
                            <td><span class="fw-bold"><%= log.action %></span></td>
                            <td><%= log.target_type %> (ID: <%= log.target_id %>)</td>
                            <td><small><%= log.detail %></small></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
